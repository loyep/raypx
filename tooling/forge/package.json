{
  "name": "@raypx/forge",
  "private": true,
  "type": "module",
  "bin": {
    "forge": "./forge.mjs"
  },
  "scripts": {
    "db": "node --import tsx src/cli/index.ts db",
    "doctor": "node --import tsx src/cli/index.ts doctor",
    "run": "node --import tsx src/cli/index.ts run",
    "setup": "node --import tsx src/cli/index.ts setup",
    "ui": "node --import tsx src/cli/index.ts ui generate",
    "clean": "rimraf dist .turbo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.53.0",
    "cac": "^7.0.0",
    "consola": "^3.4.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
