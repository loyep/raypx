{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React (JSX + Vite)",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
