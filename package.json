{
  "name": "raypx",
  "private": true,
  "description": "A modern web application built with TanStack Start and TypeScript",
  "homepage": "https://raypx.com",
  "bugs": {
    "url": "https://github.com/raypx/raypx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raypx/raypx.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Raypx Team",
    "email": "support@raypx.com"
  },
  "scripts": {
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "bump-deps": "pnpx taze -wI",
    "bump-ui": "pnpm dlx shadcn@latest add --all --overwrite -c packages/design-system && pnpm -w format",
    "changeset": "changeset",
    "clean": "forge clean",
    "coverage": "pnpm run test:coverage",
    "db": "forge db",
    "db:generate": "forge db generate",
    "db:migrate": "forge db migrate",
    "db:pull": "forge db pull",
    "db:push": "forge db push",
    "db:seed": "forge db seed",
    "db:studio": "forge db studio",
    "deps:bump": "pnpm run bump-deps",
    "dev": "pnpm run dev:web",
    "dev:full": "turbo run dev --filter=web",
    "dev:web": "turbo run dev --filter=web",
    "doctor": "forge doctor",
    "forge": "forge",
    "format": "biome check --write .",
    "preinstall": "npx only-allow pnpm",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "test -n \"$CI\" && echo 'Skipping lefthook' || lefthook install",
    "release": "changeset version",
    "setup": "forge setup",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest watch",
    "typecheck": "turbo run typecheck",
    "ui:bump": "pnpm run bump-ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@dotenvx/dotenvx": "^1.54.1",
    "@raypx/forge": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^28.1.0",
    "lefthook": "^2.1.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "turbo": "^2.8.15",
    "typescript": "^5.9.3",
    "vite": "catalog:beta",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.26.0"
  }
}
